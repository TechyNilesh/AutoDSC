@article{Hahsler2016,
  title    = {Clustering Data Streams Based on Shared Density between Micro-Clusters},
  author   = {Michael Hahsler and Matthew Bolaños},
  year     = {2016},
  abstract = {This paper presents a novel data stream clustering method DBSTREAM, which explicitly captures the density between micro-clusters (MCs) via a shared density graph. Traditional two-stage data stream clustering summarizes data streams into numerous MCs online, and reclusters them offline based on MC centers and weights, often ignoring the density in the region between MCs. DBSTREAM addresses this by estimating shared density directly from data, improving reclustering quality. The paper discusses the computational complexity, proposes fading and cleanup mechanisms for adapting to evolving streams, and evaluates DBSTREAM on synthetic and real datasets. Results show DBSTREAM achieves better clustering quality with fewer and larger MCs compared to existing methods like CluStream, DenStream, and D-Stream.},
  journal  = {IEEE Transactions on Knowledge and Data Engineering},
  doi      = {10.1109/TKDE.2016.2522412},
  url      = {https://ieeexplore.ieee.org/document/7425260}
}
