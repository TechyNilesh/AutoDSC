@inproceedings{Sculley2010,
  title     = {Web-Scale K-Means Clustering},
  author    = {D. Sculley},
  year      = {2010},
  abstract  = {We present two modifications to the popular k-means clustering algorithm to address extreme requirements for latency, scalability, and sparsity encountered in user-facing web applications. First, we propose mini-batch optimization for k-means clustering, reducing computation cost by orders of magnitude compared to the classic batch algorithm while yielding better solutions than online stochastic gradient descent. Second, we achieve sparsity with projected gradient descent and provide a fast ǫ-accurate projection onto the L1-ball. Source code is freely available.},
