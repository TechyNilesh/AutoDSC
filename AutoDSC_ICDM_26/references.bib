@inproceedings{Cao2006,
  title     = {Density-Based Clustering over an Evolving Data Stream with Noise},
  author    = {Feng Cao and Martin Ester and Weining Qian and Aoying Zhou},
  year      = {2006},
  abstract  = {Clustering is an important task in mining evolving data streams. Beside the limited memory and one-pass constraints, the nature of evolving data streams implies the requirements of no assumption on the number of clusters, discovery of clusters with arbitrary shape, and ability to handle outliers. Existing algorithms do not meet all these requirements simultaneously. We present DenStream, a new approach for evolving stream clustering. We introduce core-micro-clusters to summarize arbitrary-shaped clusters, potential core-micro-clusters and outlier micro-clusters to maintain and distinguish potential clusters and outliers respectively. A novel pruning strategy guarantees the precision of these micro-clusters with limited memory. Performance studies on real and synthetic datasets demonstrate the effectiveness and efficiency of DenStream.},
  booktitle = {SIAM International Conference on Data Mining (SDM)},
  url       = {https://epubs.siam.org/doi/abs/10.1137/1.9781611972740.9}
}

