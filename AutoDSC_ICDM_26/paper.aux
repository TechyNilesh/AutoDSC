\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Computational efficiency of AutoDSC. \emph  {Left:} throughput vs.\ memory trade-off (mean over all datasets; log--log axes); the shaded green area marks the favorable region (high throughput, low memory), where AutoDSC ($\star $) sits with the highest clustering quality, while MOStream and OACE fall outside it. \emph  {Right:} the same plane with each dataset colored by its feature-count range---memory grows only mildly with dimensionality while throughput stays bounded, indicating graceful scaling to $100$ features.}}{8}{figure.6}\protected@file@percent }
\newlabel{fig:efficiency_dim}{{6}{8}{Computational efficiency of AutoDSC. \emph {Left:} throughput vs.\ memory trade-off (mean over all datasets; log--log axes); the shaded green area marks the favorable region (high throughput, low memory), where AutoDSC ($\star $) sits with the highest clustering quality, while MOStream and OACE fall outside it. \emph {Right:} the same plane with each dataset colored by its feature-count range---memory grows only mildly with dimensionality while throughput stays bounded, indicating graceful scaling to $100$ features}{figure.6}{}}
